# Real financial data — never commit these, regardless of repo visibility.
# The app creates/reads them in the project root and inside app/*.
*.xlsx
*.xlsm
~$*.xlsx
~$*.xlsm

# Runtime folders the app manages itself (auto-created on first run)
app/uploads/
app/outputs/
app/history/
app/pending/

# Login credential (starts as the hardcoded default, but changes are saved
# here per-machine — never something to commit or share)
app/auth_data.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
